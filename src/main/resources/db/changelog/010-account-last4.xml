<?xml version="1.0" encoding="UTF-8"?>
<!--
  ─────────────────────────────────────────────────────────────
  010 — Últimos 4 dígitos do cartão
  ─────────────────────────────────────────────────────────────
  Guarda os 4 últimos dígitos impressos no cartão (só para contas
  do tipo CARD). É um identificador visual — nunca o número completo.
  Coluna opcional (nullable): cartões antigos e contas não-cartão
  ficam com NULL.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="010-01-accounts-add-last4" author="rastroos">
        <addColumn tableName="accounts">
            <column name="last4" type="VARCHAR(4)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="accounts" columnName="last4"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
