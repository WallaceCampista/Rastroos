# ─────────────────────────────────────────────────────────────
# Rastro$ — variáveis de ambiente (DEV)
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha. Nunca commitar `.env`.
#
#   cp .env.example .env
#
# Em produção, use variáveis de ambiente do orquestrador (Kubernetes,
# Vault, AWS Secrets Manager, etc.). Não use este arquivo em prod.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# POSTGRES_USER=rastroos
# POSTGRES_PASSWORD=change-me-in-local-env
# POSTGRES_DB=rastroos
# Porta no HOST (container sempre escuta em 5432 internamente).
# POSTGRES_PORT=5432

# ── Spring Boot (Etapa 2 em diante) ──────────────────────────
# Perfil ativo do Spring (dev | test | prod)
# SPRING_PROFILES_ACTIVE=dev

# JDBC URL — combina com as variáveis acima
# (será lido por application-dev.yml na Etapa 2)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rastroos
# SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
# SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ── Segurança da aplicação (placeholders) ────────────────────
# Admin inicial — criado UMA VEZ pelo changelog Liquibase
# (003-create-default-admin.xml). O usuário é criado com
# password_must_change=true: o primeiro login só serve para trocar
# a senha.
#
# Como gerar um hash BCrypt forte (cost 12):
#   htpasswd -nbB -C 12 admin "SuaSenhaForte" | cut -d: -f2 \
#       | sed 's/^\$2y\$/$2a$/'
# ou via Java:
#   new BCryptPasswordEncoder(12).encode("SuaSenhaForte")
#
# Default abaixo é o hash de "ChangeMe!2026" — PÚBLICO. Substituir
# em qualquer ambiente que não seja o seu localhost.
# RASTROOS_ADMIN_EMAIL=admin@rastroos.local
# IMPORTANTE: o valor abaixo deve estar entre aspas SIMPLES,
# senão o shell expande $2, $12, $8 como argumentos posicionais
# (vazios) e corrompe o hash.
# RASTROOS_ADMIN_PASSWORD_HASH='$2a$12$8vt9ODctuNYuCFIkcxwg8.4nx/iyBMYItRe5QzNEt5Ch54kZugHwO'

# Chave usada para HMAC/sign de tokens internos (32+ chars).
# Gere algo forte (ex.: openssl rand -base64 48).
# RASTROOS_APP_SECRET=replace-with-32+chars-random-secret

# ── Alfredo (IA) — placeholders (Etapa 13) ───────────────────
# Vazio = modo demonstração (stub, sem chamada externa).
# ALFREDO_API_BASE_URL=
# ALFREDO_API_KEY=
# ALFREDO_MODEL=gpt-4o-mini

# ── Logs / observabilidade ───────────────────────────────────
# LOG_LEVEL=INFO
